---
// 05c 3D case — Bunpro key visual (Figma 318:1595, mobile 327:3106).
import Case from '../../layouts/Case.astro';
import BriefConcept from '../../components/case/BriefConcept.astro';
import Gallery from '../../components/case/Gallery.astro';
import NextProject from '../../components/case/NextProject.astro';

import kvFinal from '../../assets/images/3d/key-visual/final.webp';
import wallpaperHero from '../../assets/images/3d/wallpaper/final-03.webp';
import type { ImageMetadata } from 'astro';

const rejectedFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/3d/key-visual/rejected-*.webp', { eager: true });
const rejected = Object.keys(rejectedFiles)
  .sort()
  .map((path, i) => ({ image: rejectedFiles[path].default, alt: `Rejected key visual direction ${i + 1}` }));
const rows = [{ ratio: 4 / 3, cols: 3, mobile: 'grid' as const, items: rejected }];
---

<Case
  section="3d"
  head={{
    band: '3d',
    tag: '3D',
    no: 'No. 01 · ©2025',
    all: { label: 'All 3D', href: '/3d' },
    title: 'Bunpro key visual',
    lead: 'A key visual for an existing product',
    meta: [
      { label: 'TYPE', value: '3D key visual' },
      { label: 'ROLE', value: 'Scene, lighting, render' },
      { label: 'FORMAT', value: '1600×1200' },
      { label: 'TOOLS', value: 'Cinema 4D · Redshift' },
    ],
  }}
>
  <Gallery hero label="Hero" groups={[{ rows: [{ items: [{ image: kvFinal, alt: 'Pink knitted kanji sign rising from a sea of blue kanji blocks' }] }] }]} />

  <BriefConcept
    brief="Draw a key visual for one of the existing products, digital or physical. I took Bunpro again: I plan to redesign the platform itself, so the icon set and the key visual will be used later."
    concept="One pink knitted sign — the same yarn and rope as the icon set — rises from a sea of blue kanji blocks. The icon language becomes a scene: one warm, tactile hero against a cold, dense field of characters."
  />

  <Gallery
    label="Rejected directions"
    groups={[{
      label: '01 · REJECTED DIRECTIONS',
      text: 'Twelve explorations on the way to the final: flower fields, color swaps, glass and confetti versions of the same sign.',
      rows,
    }]}
  />

  <NextProject
    label="NEXT · 02 / 03"
    title="Primitives · wallpaper"
    lead="Abstract wallpapers in the spirit of Windows"
    href="/3d/wallpaper"
    band="3d"
    image={wallpaperHero}
    thumb={{ w: 400, h: 300 }}
  />
</Case>
