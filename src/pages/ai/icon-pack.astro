---
// 04a AI case — 3D Icon Pack (Figma 313:1172, mobile 327:2035).
import Case from '../../layouts/Case.astro';
import BriefConcept from '../../components/case/BriefConcept.astro';
import Gallery from '../../components/case/Gallery.astro';
import SetGrid from '../../components/case/SetGrid.astro';
import NextProject from '../../components/case/NextProject.astro';
import type { ImageMetadata } from 'astro';
import type { GItem } from '../../components/case/types';

import noxisBillboard from '../../assets/images/ai/noxis/billboard.webp';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/ai/icon-pack/set-0*/*.webp', { eager: true });
const img = (set: number, name: string) => files[`../../assets/images/ai/icon-pack/set-0${set}/${name}.webp`].default;

const setNames = ['construction toys', 'fruits with stickers', 'keychains'];
const sets = [1, 2, 3].map((n) => ({
  label: `SET 0${n} · REFERENCE → 8 ICONS`,
  big: {
    image: img(n, 'reference'),
    alt: `Set ${n} style reference (${setNames[n - 1]})`,
    fit: n === 3 ? 'contain' : 'cover',
  } as GItem,
  small: Array.from({ length: 8 }, (_, i) => ({
    image: img(n, `icon-0${i + 1}`),
    alt: `Set ${n}, ${setNames[n - 1]}: icon ${i + 1}`,
  })),
}));
---

<Case
  section="ai"
  head={{
    band: 'ai',
    tag: 'AI',
    no: 'No. 01 · ©2026',
    all: { label: 'All AI', href: '/ai' },
    title: '3D Icon Pack',
    lead: 'Reference mixing & consistency control',
    meta: [
      { label: 'TYPE', value: 'AI production' },
      { label: 'ROLE', value: 'Art direction, AI pipeline' },
      { label: 'YEAR', value: '2026' },
      { label: 'CONTEXT', value: 'AI Upgrade · Wannabe' },
    ],
  }}
>
  <Gallery hero label="Hero" groups={[{ rows: [{ ratio: 1, mobile: 'grid', items: [
    { image: img(1, 'icon-01'), alt: 'Lilac 3D excavator keychain icon', zoom: 1.1 },
    { image: img(2, 'icon-04'), alt: 'Melon with marketing stickers, 3D icon' },
  ] }] }]} />

  <BriefConcept
    brief="Build a pack of 3D icons not from scratch, but through reference mixing — and keep one visual language across the whole series."
    concept="The point was not to generate a pretty picture, but to drive an AI tool like a constructor: form from one reference, color, light and material from another — and each layer controlled on its own."
  />

  <section class="cs" aria-labelledby="process-title">
    <div class="container process">
      <h2 class="t-h2" id="process-title">Process</h2>
      <Gallery
        label="Process steps"
        groups={[{ rows: [{ ratio: 1, items: [
          { image: img(1, 'reference'), alt: 'Style reference for set 1', title: '01 · Style reference', text: 'Color, light and material are taken from this reference.' },
          { image: img(1, 'icon-02'), alt: 'Wrench and screwdriver icon rebuilt in the reference style', title: '02 · Object + mix', text: 'The object comes from a separate reference and is rebuilt in the style of the first.' },
          { image: img(1, 'icon-04'), alt: 'Hammer icon from the consistent series', title: '03 · Consistent series', text: 'Same light setup and materials across all eight icons of a set.' },
        ] }] }]}
      />
    </div>
  </section>

  <section class="cs" aria-label="Sets">
    <div class="container sets">
      {sets.map((s) => <SetGrid label={s.label} big={s.big} small={s.small} />)}
    </div>
  </section>

  <NextProject
    label="NEXT · 02 / 03"
    title="NOXIS"
    lead="A brand from scratch: identity, product, campaign"
    href="/ai/noxis"
    band="ai"
    image={noxisBillboard}
    thumb={{ w: 480, h: 300 }}
  />
</Case>

<style>
  .process {
    display: flex;
    flex-direction: column;
    gap: var(--layout-title-gap);
  }
  /* The nested Gallery is a section of its own: drop its padding here. */
  .process :global(.cs) { padding: 0; }
  .process :global(.container) { padding-inline: 0; }
  .sets {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }
</style>
