---
/**
 * Plaque — the signature element: a colored rounded rectangle tightly wrapping a label.
 * Sizes map to Figma: xl = Display, l = H1, m = H2, s = Tag (`dense` = header variant).
 * With `href` it becomes interactive. Hover (Vanya, 2026-10-12): the plaque turns grey and the
 * label takes the plaque's section color (`accent` overrides it, e.g. the white 3D plaque → blue).
 * Press: scale .97. No outline except :focus-visible (a11y).
 */

export type PlaqueColor = 'product' | '3d' | 'ai' | 'comms' | 'about' | 'white' | 'ink';
export type PlaqueSize = 'xl' | 'l' | 'm' | 's' | 'menu';

interface Props {
  size?: PlaqueSize;
  color?: PlaqueColor;
  href?: string;
  /** Element when not a link: span (default), h1, h2, button … */
  as?: 'span' | 'div' | 'h1' | 'h2' | 'h3' | 'p' | 'button';
  /** Header variant of the small plaque (pad 4/12/5/12). */
  dense?: boolean;
  /** Marks the current section (aria-current only, no visual state). */
  current?: boolean;
  /** Joined pair: square the inner corners. */
  join?: 'start' | 'end';
  /** Label color on hover (defaults to the plaque's own color). */
  accent?: PlaqueColor;
  class?: string;
  [key: string]: unknown;
}

const {
  size = 'm',
  color = 'product',
  href,
  as = 'span',
  dense = false,
  current = false,
  join,
  accent,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : as;
const interactive = Boolean(href) || as === 'button';
const classes = [
  'plaque',
  `plaque--${size}`,
  `plaque--${color}`,
  dense && 'plaque--dense',
  interactive && 'plaque--interactive',
  join && `plaque--join-${join}`,
  accent && `plaque--accent-${accent}`,
  className,
];
const attrs: Record<string, unknown> = href ? { href } : {};
if (current) attrs['aria-current'] = 'page';
---

<Tag class:list={classes} {...attrs} {...rest}>
  <span class="plaque__label"><slot /></span>
</Tag>

<style>
  .plaque {
    --plaque-bg: var(--section-product);
    --plaque-fg: var(--text-primary);
    display: inline-flex;
    align-items: center;
    width: max-content;
    max-width: 100%;
    background: var(--plaque-bg);
    color: var(--plaque-fg);
    border-radius: var(--radius-base);
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }

  /* Colors */
  /* --plaque-accent = label color on hover (over the grey hover fill). */
  .plaque--product { --plaque-bg: var(--section-product); --plaque-accent: var(--section-product); }
  .plaque--3d { --plaque-bg: var(--section-3d); --plaque-accent: var(--section-3d); }
  .plaque--ai { --plaque-bg: var(--section-ai); --plaque-accent: var(--section-ai); }
  .plaque--comms { --plaque-bg: var(--section-comms); --plaque-accent: var(--section-comms); }
  .plaque--about { --plaque-bg: var(--section-about); --plaque-accent: var(--color-white); }
  .plaque--white { --plaque-bg: var(--color-white); --plaque-accent: var(--color-white); }
  .plaque--ink { --plaque-bg: var(--surface-inverse); --plaque-fg: var(--text-inverse); --plaque-accent: var(--color-black); }
  .plaque--accent-product { --plaque-accent: var(--section-product); }
  .plaque--accent-3d { --plaque-accent: var(--section-3d); }
  .plaque--accent-ai { --plaque-accent: var(--section-ai); }
  .plaque--accent-comms { --plaque-accent: var(--section-comms); }

  /* Sizes — padding values are Figma's plaque paddings (top/right/bottom/left). */
  .plaque--xl {
    font: 700 var(--size-display)/0.9 var(--font-sans);
    letter-spacing: -0.03em;
    padding: 6px 20px 8px;
  }
  @media (max-width: 767px) {
    .plaque--xl { padding: var(--space-4) var(--space-12) 5px; }
  }
  .plaque--l {
    font: 700 var(--size-h1)/1 var(--font-sans);
    letter-spacing: -0.03em;
    padding: 6px 20px 8px;
  }
  .plaque--m {
    font: 700 var(--size-h2)/1 var(--font-sans);
    letter-spacing: -0.03em;
    padding: 6px 20px 8px;
  }
  .plaque--s {
    font: 700 var(--size-tag)/1.2 var(--font-sans);
    padding: 5px var(--space-12) 6px;
  }
  .plaque--s.plaque--dense { padding: var(--space-4) var(--space-12) 5px; }
  /* Mobile header pill / mobile hero small plaques: Plaque S type in a small plaque. */
  .plaque--menu {
    font: 700 var(--size-plaque-s)/1.1 var(--font-sans);
    letter-spacing: -0.01em;
    padding: var(--space-4) var(--space-12) 5px;
  }

  /* Joined pair (About + Contact) */
  .plaque--join-start { border-start-end-radius: 0; border-end-end-radius: 0; }
  .plaque--join-end { border-start-start-radius: 0; border-end-start-radius: 0; }

  /* Interactive */
  .plaque--interactive {
    position: relative;
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  .plaque__label { display: inline-block; }

  /* Hover: grey plaque, label in the section color. */
  @media (hover: hover) {
    .plaque--interactive:hover,
    .plaque--interactive.is-hover {
      background: var(--surface-neutral);
      color: var(--plaque-accent);
    }
  }
  .plaque--interactive:active { transform: scale(0.97); }
  /* Keyboard focus keeps the global outline; lift it above a joined neighbour. */
  .plaque--interactive:focus-visible { z-index: 1; }

  @media (prefers-reduced-motion: reduce) {
    .plaque--interactive:active { transform: none; }
  }
</style>
