---
/**
 * Home hero (Figma 291:122 desktop 1440×900, 327:441 mobile).
 * Desktop: plaques placed at Figma positions relative to the frame center (x − 720).
 * Mobile: lead → bear → plaque row → meta, in flow.
 */
import Plaque from '../Plaque.astro';
import Bear from '../Bear.astro';
import { person, tbilisiTime } from '../../content/site';
---

<section class="hero" data-hero aria-label="Intro">
  <div class="hero__inner">
    <div class="hero__brand">
      <p class="t-plaque-s">{person.name}</p>
      <p class="t-body-s">{person.role}</p>
    </div>

    <p class="t-lead hero__lead">
      I design digital products end to end — and make 3D, comms and AI visuals.
    </p>

    <div class="hero__bear">
      <Bear />
    </div>

    <nav class="hero__nav" aria-label="Sections">
      <ul role="list">
        <li class="hero__p hero__p--product"><Plaque size="l" color="product" href="/product">Product</Plaque></li>
        <li class="hero__p hero__p--3d"><Plaque size="m" color="white" href="/3d">3D</Plaque></li>
        <li class="hero__p hero__p--comms"><Plaque size="m" color="comms" href="/comms">Comms</Plaque></li>
        <li class="hero__p hero__p--ai"><Plaque size="m" color="ai" href="/ai">AI</Plaque></li>
        <li class="hero__p hero__p--joined">
          <Plaque size="m" color="about" href="#about" join="start">About</Plaque>
          <Plaque size="m" color="product" href="#contact" join="end">Contact</Plaque>
        </li>
      </ul>
    </nav>

    <div class="hero__meta t-mono">
      <a class="link" href={`mailto:${person.email}`}>{person.email}</a>
      <p>{person.city} · <time data-clock>{tbilisiTime()}</time> · RU / EN</p>
      <a class="link hero__scroll" href="#product">scroll ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--section-3d);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    max-width: var(--page-max);
    height: 900px;
    margin-inline: auto;
  }

  /* Desktop: absolute composition from Figma */
  .hero__brand {
    position: absolute;
    top: 28px;
    left: var(--layout-gutter);
  }
  .hero__brand .t-plaque-s { line-height: 26px; }
  .hero__lead {
    position: absolute;
    z-index: 2;
    top: 150px;
    left: var(--layout-gutter);
    width: 380px;
  }
  .hero__bear {
    position: absolute;
    top: 18px;
    left: calc(50% - 452px);
    width: 904px;
  }
  .hero__nav ul { display: contents; }
  .hero__p {
    position: absolute;
    z-index: 2;
    display: flex;
  }
  .hero__p--product { top: 261px; left: calc(50% - 498px); }
  .hero__p--3d { top: 250px; left: calc(50% + 330px); }
  .hero__p--comms { top: 678px; left: calc(50% - 414px); }
  .hero__p--ai { top: 553px; left: calc(50% + 309px); }
  .hero__p--joined { top: 0; right: 0; }

  .hero__meta {
    position: absolute;
    z-index: 2;
    left: var(--layout-gutter);
    right: var(--layout-gutter);
    bottom: var(--space-32);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .hero__meta > :last-child { justify-self: end; }

  /* Mobile (327:441): in-flow stack */
  @media (max-width: 767px) {
    .hero__inner {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
      padding: var(--space-24) var(--layout-gutter) 20px;
    }
    .hero__brand,
    .hero__scroll,
    .hero__p--joined { display: none; }
    .hero__lead,
    .hero__bear,
    .hero__p,
    .hero__meta { position: static; }
    .hero__lead { width: auto; }
    .hero__bear { width: 100%; }
    .hero__nav ul {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8);
    }
    .hero__nav :global(.plaque) {
      font: 700 var(--size-plaque-s)/1.1 var(--font-sans);
      letter-spacing: -0.01em;
      padding: var(--space-4) var(--space-12) 5px;
    }
    .hero__p--product :global(.plaque) {
      font-size: var(--size-h2);
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .hero__meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
