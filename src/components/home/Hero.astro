---
/**
 * Home hero (Figma 291:122 desktop 1440×900, 327:441 mobile).
 * Desktop: plaques placed at Figma positions relative to the frame center (x − 720).
 * Mobile: lead → bear → plaque row → meta, in flow.
 */
import Plaque from '../Plaque.astro';
import Bear from '../Bear.astro';
import { person, tbilisiTime } from '../../content/site';
---

<section class="hero" data-hero aria-label="Intro">
  <div class="hero__inner">
    <div class="hero__brand">
      <p class="t-plaque-s">{person.name}</p>
      <p class="t-body-s">{person.role}</p>
    </div>

    <p class="t-lead hero__lead">
      I design digital products end to end — and make 3D, comms and AI visuals.
    </p>

    <div class="hero__bear">
      <Bear />
    </div>

    <nav class="hero__nav" aria-label="Sections">
      <ul role="list">
        <li class="hero__p hero__p--product"><Plaque size="l" color="product" href="/product">Product</Plaque></li>
        <li class="hero__p hero__p--3d"><Plaque size="m" color="white" href="/3d">3D</Plaque></li>
        <li class="hero__p hero__p--comms"><Plaque size="m" color="comms" href="/comms">Comms</Plaque></li>
        <li class="hero__p hero__p--ai"><Plaque size="m" color="ai" href="/ai">AI</Plaque></li>
        <li class="hero__p hero__p--shots"><Plaque size="m" color="ink" href="/shots">Shots</Plaque></li>
        <li class="hero__p hero__p--joined">
          <Plaque size="menu" color="about" href="#about" join="start">About</Plaque>
          <Plaque size="menu" color="product" href="#contact" join="end">Contact</Plaque>
        </li>
      </ul>
    </nav>

    <div class="hero__meta t-mono">
      <a class="link" href={`mailto:${person.email}`}>{person.email}</a>
      <p>{person.city} · <time data-clock>{tbilisiTime()}</time> · RU / EN</p>
      <a class="link hero__scroll" href="#product">scroll ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--section-3d);
    overflow: hidden;
  }
  /* Desktop: exactly one screen tall at any viewport (no strip under the hero).
     The Figma 1440×900 composition scales with the hero height:
     --u = one Figma px at the current height. */
  .hero__inner {
    position: relative;
    max-width: var(--page-max);
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    margin-inline: auto;
    container-type: size;
    --u: calc(100cqh / 900);
  }

  .hero__brand {
    position: absolute;
    top: 28px;
    left: var(--layout-gutter);
  }
  .hero__brand .t-plaque-s { line-height: 26px; }
  .hero__lead {
    position: absolute;
    z-index: 2;
    top: calc(150 * var(--u));
    left: var(--layout-gutter);
    width: 380px;
  }
  .hero__bear {
    position: absolute;
    top: calc(18 * var(--u));
    left: calc(50% - 452 * var(--u));
    width: calc(904 * var(--u));
  }
  .hero__nav ul { display: contents; }
  .hero__p {
    position: absolute;
    z-index: 2;
    display: flex;
  }
  .hero__p--product { top: calc(261 * var(--u)); left: calc(50% - 498 * var(--u)); }
  .hero__p--3d { top: calc(250 * var(--u)); left: calc(50% + 330 * var(--u)); }
  .hero__p--comms { top: calc(678 * var(--u)); left: calc(50% - 414 * var(--u)); }
  .hero__p--ai { top: calc(553 * var(--u)); left: calc(50% + 309 * var(--u)); }
  /* Not in Figma — added by Vanya (2026-10-12). */
  .hero__p--shots { top: calc(724 * var(--u)); left: calc(50% + 196 * var(--u)); }
  .hero__p--joined { top: 0; right: 0; }

  /* Volume: soft drop shadow under every hero plaque (requested by Vanya). */
  .hero__nav :global(.plaque) {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-black) 8%, transparent),
      0 10px 24px -12px color-mix(in srgb, var(--color-black) 22%, transparent);
  }

  /* Slow drift around the hero: each plaque wanders on its own loop.
     The joined About + Contact pair stays anchored to the corner. */
  .hero__p:not(.hero__p--joined) {
    animation: plaque-drift-a 26s ease-in-out infinite;
    will-change: transform;
  }
  .hero__p.hero__p--3d { animation-name: plaque-drift-b; animation-duration: 31s; animation-delay: -6s; }
  .hero__p.hero__p--comms { animation-name: plaque-drift-c; animation-duration: 28s; animation-delay: -12s; }
  .hero__p.hero__p--ai { animation-name: plaque-drift-b; animation-duration: 24s; animation-delay: -17s; }
  .hero__p.hero__p--shots { animation-name: plaque-drift-a; animation-duration: 34s; animation-delay: -9s; }

  @keyframes plaque-drift-a {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(48px, -28px) rotate(-1.5deg); }
    50% { transform: translate(16px, 36px) rotate(1deg); }
    75% { transform: translate(-40px, 12px) rotate(-0.5deg); }
  }
  @keyframes plaque-drift-b {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(-36px, 30px) rotate(1.5deg); }
    50% { transform: translate(-60px, -20px) rotate(-1deg); }
    75% { transform: translate(24px, -36px) rotate(0.5deg); }
  }
  @keyframes plaque-drift-c {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(56px, 24px) rotate(-1deg); }
    66% { transform: translate(-28px, -40px) rotate(1.5deg); }
  }
  /* Mobile: plaques sit in a row, so only a gentle float. */
  @keyframes plaque-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__p:not(.hero__p--joined) { animation: none; }
  }

  .hero__meta {
    position: absolute;
    z-index: 2;
    left: var(--layout-gutter);
    right: var(--layout-gutter);
    bottom: var(--space-32);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .hero__meta > :last-child { justify-self: end; }

  /* Mobile (327:441): in-flow stack */
  @media (max-width: 767px) {
    .hero__inner {
      height: auto;
      min-height: 0;
      container-type: normal;
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
      padding: var(--space-24) var(--layout-gutter) 20px;
    }
    .hero__brand,
    .hero__scroll,
    .hero__p--joined { display: none; }
    .hero__lead,
    .hero__bear,
    .hero__p,
    .hero__meta { position: static; }
    .hero__lead { width: auto; }
    .hero__bear { width: 100%; }
    .hero__nav ul {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8);
    }
    .hero__nav :global(.plaque) {
      font: 700 var(--size-plaque-s)/1.1 var(--font-sans);
      letter-spacing: -0.01em;
      padding: var(--space-4) var(--space-12) 5px;
    }
    .hero__p:not(.hero__p--joined) { animation-name: plaque-float; animation-duration: 4s; }
    .hero__p--product :global(.plaque) {
      font-size: var(--size-h2);
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .hero__meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
