---
/**
 * Home → 3D & AI wall (Figma 292:2; behaviour note 342:1342; mobile 327:316).
 * Per Vanya (2026-10-12): bento of frames at their original aspect ratios — columns of 1–4
 * stacked tiles whose widths are solved to fill the wall height exactly (content/projects.ts → pack()).
 * The whole wall moves together. Content: all 3D, curated AI, every shot.
 * Desktop: the grid is duplicated once for a seamless loop (copy is aria-hidden / inert).
 *   JS (scripts/wall.ts): auto-scroll, wheel → horizontal, hover pause, drag + inertia, filter.
 *   No JS: the grid is a plain horizontally scrollable strip, filter hidden.
 * Mobile: horizontal strip of 200px squares (mobile frame), no auto-scroll.
 */
import Plaque from '../Plaque.astro';
import Button from '../Button.astro';
import Img from '../Img.astro';
import { wallTiles, wallColumns, WALL_HEIGHT, type WallTile } from '../../content/projects';

type ImageTile = Extract<WallTile, { kind: 'image' }>;
const imageTiles = wallTiles.filter((t): t is ImageTile => t.kind === 'image');

// Loop copy is hidden from AT and focus.
const DUPE: Record<string, string | boolean> = { 'aria-hidden': 'true', inert: true };
const NONE: Record<string, string | boolean> = {};
---

<section id="work" class="wall-section" aria-labelledby="work-title">
  <div class="container wall-section__head">
    <h2 id="work-title" class="wall-section__title">
      <Plaque size="l" color="3d">3D</Plaque>
      <Plaque size="l" color="about" aria-hidden="true">+</Plaque>
      <span class="visually-hidden">and</span>
      <Plaque size="l" color="ai">AI</Plaque>
    </h2>
    <p class="t-mono">renders · loops · AI production</p>
  </div>

  <!-- Desktop wall -->
  <div class="wall" data-wall data-filter="all" style={`--wall-h:${WALL_HEIGHT}px`}>
    <div class="wall__viewport" data-row data-speed="18" data-dir="1">
      <div class="wall__track" data-track>
        {
          [0, 1].map((copy) => (
            <div class:list={['wall__grid', copy === 1 && 'wall__dupe']} {...(copy === 1 ? DUPE : NONE)}>
              {wallColumns.map((col) => (
                <div class="wall__col" style={`--w:${col.width}px`}>
                  {col.tiles.map((tile) => {
                    const style = `--r:${tile.ratio}`;
                    if (tile.kind === 'intro')
                      return (
                        <div class="wall__tile wall__tile--intro" style={style}>
                          <p class="t-mono-s">3D / AI</p>
                          <p class="t-h3">Renders, icon sets, AI pipelines and characters.</p>
                        </div>
                      );
                    if (tile.kind === 'next')
                      return (
                        <div class="wall__tile wall__tile--next" style={style}>
                          <p class="t-mono-s">NEXT</p>
                          <p class="t-h3">Comms work</p>
                          <Button href="/comms">Open</Button>
                        </div>
                      );
                    return (
                      <a class="wall__tile wall__tile--image" href={tile.href} data-cat={tile.category} draggable="false" style={style}>
                        <div class="media wall__media">
                          <Img
                            src={tile.image}
                            alt={copy === 1 ? '' : tile.alt}
                            width={Math.round(col.width)}
                            sizes={`${Math.round(col.width)}px`}
                          />
                        </div>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="wall__filter" role="group" aria-label="Filter works">
      <Plaque as="button" size="s" color="about" data-filter-btn="shots" aria-pressed="false">Shots</Plaque>
      <Plaque as="button" size="s" color="3d" data-filter-btn="3d" aria-pressed="false">3D</Plaque>
      <Plaque as="button" size="s" color="ai" data-filter-btn="ai" aria-pressed="false">AI</Plaque>
      <Plaque as="button" size="s" color="white" data-filter-btn="all" aria-pressed="true">All</Plaque>
    </div>
  </div>

  <!-- Mobile wall -->
  <div class="wall-m">
    <p class="t-h3 container">Renders, icon sets, AI pipelines and characters.</p>
    <ul class="wall-m__strip" role="list">
      {
        imageTiles.map((tile) => (
          <li style={`--r:${tile.ratio}`}>
            <a href={tile.href} class="media wall-m__media">
              <Img src={tile.image} alt={tile.alt} width={Math.round(200 * tile.ratio)} sizes={`${Math.round(200 * tile.ratio)}px`} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../../scripts/wall';
</script>

<style>
  .wall-section {
    display: flex;
    flex-direction: column;
    gap: var(--layout-title-gap);
    padding-block: var(--layout-section-y);
  }
  .wall-section__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-16);
  }
  .wall-section__title {
    display: flex;
    gap: var(--space-16);
  }

  /* ── Desktop wall ───────────────────────────── */
  .wall {
    position: relative;
    user-select: none;
  }
  .wall__viewport {
    overflow-x: auto;
    scrollbar-width: none;
    touch-action: pan-y;
  }
  .wall__viewport::-webkit-scrollbar { display: none; }
  :global(.js) .wall__viewport { overflow: hidden; cursor: grab; }
  :global(.js) .wall__viewport.is-dragging { cursor: grabbing; }

  .wall__track {
    display: flex;
    gap: var(--layout-wall-gap);
    width: max-content;
    will-change: transform;
  }
  .wall__grid {
    display: flex;
    gap: var(--layout-wall-gap);
    height: var(--wall-h);
  }
  .wall__dupe { display: none; }
  :global(.js) .wall__dupe { display: flex; }

  /* Column width is solved at build time so its tiles fill --wall-h exactly. */
  .wall__col {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: var(--layout-wall-gap);
    width: var(--w);
  }
  .wall__tile {
    flex: none;
    width: 100%;
    aspect-ratio: var(--r);
    border-radius: var(--radius-base);
  }
  /* Absorb sub-pixel rounding in the last tile so columns end flush. */
  .wall__col > :last-child { flex: 1 1 auto; aspect-ratio: auto; min-height: 0; }
  .wall__tile--image { display: block; }
  .wall__media { width: 100%; height: 100%; }

  .wall__tile--intro,
  .wall__tile--next {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: calc(var(--space-24) + var(--space-4));
  }
  .wall__tile--intro { background: var(--section-3d); }
  .wall__tile--next { background: var(--section-ai); }

  /* Filter: dim non-matching tiles, layout never changes. */
  .wall__tile--image { transition: opacity 300ms var(--ease-out), filter 300ms var(--ease-out); }
  .wall[data-filter='3d'] [data-cat]:not([data-cat='3d']),
  .wall[data-filter='ai'] [data-cat]:not([data-cat='ai']),
  .wall[data-filter='shots'] [data-cat]:not([data-cat='shots']) {
    opacity: 0.2;
    filter: grayscale(1);
  }

  .wall__filter {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 26px;
    display: none;
    gap: 6px;
    padding: var(--space-8);
    background: var(--surface-inverse);
    border-radius: var(--radius-base);
    transform: translateX(-50%);
  }
  :global(.js) .wall__filter { display: flex; }

  /* ── Mobile wall ────────────────────────────── */
  .wall-m { display: none; }

  @media (max-width: 767px) {
    .wall-section__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-12);
    }
    .wall-section__title {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-12);
    }
    .wall { display: none; }
    .wall-m {
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
    }
    .wall-m__strip {
      display: flex;
      gap: var(--space-12);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--layout-gutter);
      padding-inline: var(--layout-gutter);
      scrollbar-width: none;
    }
    .wall-m__strip::-webkit-scrollbar { display: none; }
    .wall-m__strip li { flex: none; scroll-snap-align: start; }
    .wall-m__media {
      display: block;
      height: 200px;
      aspect-ratio: var(--r);
    }
  }
</style>
