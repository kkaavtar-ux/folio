---
/**
 * Site header — desktop (79px: brand · section tags · joined About+Contact)
 * and mobile (59px: brand · pink "Menu ≡" pill → MobileMenu overlay).
 * `overHero`: fixed and hidden while the home hero is in view (the hero plaques are the nav).
 * Scroll: after 80px, scrolling down hides it; scrolling up ≥16px shows it (scripts/header.ts).
 */
import Plaque from './Plaque.astro';
import Tag from './Tag.astro';
import MobileMenu from './MobileMenu.astro';
import { sections, person, type SectionKey } from '../content/site';

interface Props {
  current?: SectionKey | 'shots';
  overHero?: boolean;
}

const { current, overHero = false } = Astro.props;
---

<header class:list={['site-header', overHero && 'site-header--over-hero']} data-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${person.name} — home`}>
      <span class="t-plaque-s">{person.name}</span>
      <span class="t-body-s site-header__role">{person.role}</span>
    </a>

    <nav class="site-header__nav" aria-label="Sections">
      <ul role="list">
        {
          sections.map((s) => (
            <li>
              <Tag href={s.href} color={s.color} dense current={current === s.key}>
                {s.label}
              </Tag>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__aside">
      <Plaque size="s" dense color="about" href="/#about" join="start">About</Plaque>
      <Plaque size="s" dense color="product" href="/#contact" join="end">Contact</Plaque>
    </div>

    <Plaque
      href="#site-menu"
      role="button"
      size="menu"
      color="product"
      class="site-header__menu"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-open
    >
      Menu ≡
    </Plaque>
  </div>
</header>

<MobileMenu current={current} />

<script>
  import '../scripts/header';
  import '../scripts/mobile-menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-page);
    padding-top: env(safe-area-inset-top);
    transition: transform 300ms var(--ease-out);
  }
  .site-header--over-hero {
    position: fixed;
    inset-inline: 0;
  }
  .site-header.is-hidden { transform: translateY(-100%); }
  /* Keep the header reachable for keyboard users even while scrolled away. */
  .site-header:focus-within { transform: none; }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-24);
    max-width: var(--page-max);
    min-height: 79px;
    margin-inline: auto;
    padding: var(--space-16) var(--layout-gutter);
  }

  .site-header__brand { display: flex; flex-direction: column; justify-self: start; }
  .site-header__brand .t-plaque-s { line-height: 26px; }

  .site-header__nav ul { display: flex; gap: var(--space-8); }

  .site-header__aside { display: flex; justify-self: end; }

  .site-header__menu { display: none; }

  @media (max-width: 767px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 59px;
      padding-block: var(--space-12);
    }
    .site-header__nav,
    .site-header__aside { display: none; }
    .site-header__menu { display: inline-flex; justify-self: end; }
    .site-header__brand .t-plaque-s { line-height: 20px; }
    .site-header__role { line-height: 15px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
