---
/**
 * UnderConstruction — Figma "Stub · under construction" (300:1668), 1376×720.
 * The whole composition scales with its width (container query units), so the same
 * component works full-width on Home, as the Product list thumb and on mobile.
 * Tape: black band, 80px pink stripes every 160px, 120px tall, flush with the bottom.
 */
interface Props {
  caption?: string;
  class?: string;
}

const { caption = 'TEAM MODE · SALMON — CASE IN PROGRESS', class: className } = Astro.props;
---

<div class:list={['uc', className]}>
  <div class="uc__box">
    <p class="uc__caption">{caption}</p>
    <p class="uc__title">Under<br />construction</p>
    <span class="uc__tape" aria-hidden="true"></span>
  </div>
</div>

<style>
  .uc {
    container-type: inline-size;
    border-radius: var(--radius-base);
    overflow: hidden;
  }
  /* 1 unit = 1 Figma px at 1376 wide. */
  .uc__box {
    --u: calc(100cqw / 1376);
    position: relative;
    aspect-ratio: 1376 / 720;
    background: var(--surface-tile);
  }
  .uc__caption {
    position: absolute;
    top: calc(56 * var(--u));
    left: calc(64 * var(--u));
    font: 400 calc(13 * var(--u)) / 1.4 var(--font-mono);
  }
  .uc__title {
    position: absolute;
    top: calc(100 * var(--u));
    left: calc(60 * var(--u));
    font: 700 calc(120 * var(--u)) / 0.9 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .uc__tape {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(120 * var(--u));
    background-color: var(--color-black);
    background-image: repeating-linear-gradient(
      90deg,
      var(--section-product) 0 calc(80 * var(--u)),
      transparent calc(80 * var(--u)) calc(160 * var(--u))
    );
  }
</style>
