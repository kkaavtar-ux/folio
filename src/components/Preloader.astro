---
/**
 * Preloader (BRIEF §4.1) — first visit per session only, never with reduced motion or without JS.
 * A black disc full of white organic "cells" (metaballs via blur + contrast) carrying mono numbers;
 * the centre number counts 0 → 100. One inversion beat, collapse to a dot, then blur/fade out.
 * It is a fixed overlay: the page renders underneath (does not block LCP). Total ≈ 2.3s.
 * Shown via html.preload (set by the inline head script in Base.astro).
 */
---

<div class="preloader" aria-hidden="true" data-preloader>
  <div class="pl__disc" data-pl-disc>
    <canvas class="pl__goo" data-pl-goo></canvas>
    <canvas class="pl__nums" data-pl-nums></canvas>
  </div>
</div>

<script>
  import '../scripts/preloader';
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    place-items: center;
    background: var(--bg-page);
    transition: opacity 400ms var(--ease-out), filter 400ms var(--ease-out);
  }
  :global(html.preload) .preloader { display: grid; }
  :global(html.preload) body { overflow: hidden; }
  .preloader.is-out {
    opacity: 0;
    filter: blur(16px);
  }

  .pl__disc {
    position: relative;
    width: var(--pl-size, 320px);
    height: var(--pl-size, 320px);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-black);
    transition: transform 300ms cubic-bezier(0.7, 0, 0.84, 0), filter 120ms linear;
  }
  .pl__disc.is-inverted { filter: invert(1); }
  .pl__disc.is-collapsed { transform: scale(0.04); }
  .pl__goo,
  .pl__nums {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Blur + hard contrast turns overlapping circles into merging cells. */
  .pl__goo { filter: blur(9px) contrast(30); }
</style>
